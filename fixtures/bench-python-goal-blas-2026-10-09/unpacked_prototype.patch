+//! Temporary diagnostic provider; not a production API.
+use std::ffi::{CString, c_char, c_void};
+use std::sync::OnceLock;
+#[link(name = "dl")]
+unsafe extern "C" {
+    fn dlopen(name: *const c_char, flags: i32) -> *mut c_void;
+    fn dlsym(handle: *mut c_void, name: *const c_char) -> *mut c_void;
+}
+type Sgemm = unsafe extern "C" fn(*const c_char,*const c_char,*const i32,*const i32,*const i32,*const f32,*const f32,*const i32,*const f32,*const i32,*const f32,*mut f32,*const i32);
+type Threads = unsafe extern "C" fn(i32) -> i32;
+struct Provider { gemm: Sgemm, threads: Threads }
+static PROVIDER: OnceLock<Option<Provider>> = OnceLock::new();
+pub fn run(x: &[f32], rows: usize, input: usize, weight: &[f32], output: usize, y: &mut [f32]) -> bool {
+    let provider = PROVIDER.get_or_init(|| {
+        let path = CString::new(std::env::var("LAYA_MKL_DIAGNOSTIC_LIBRARY").ok()?).unwrap();
+        let handle = unsafe { dlopen(path.as_ptr(), 2) };
+        assert!(!handle.is_null(), "unable to load diagnostic MKL library");
+        let symbol = |name: &str| { let name=CString::new(name).unwrap(); let pointer=unsafe { dlsym(handle,name.as_ptr()) }; assert!(!pointer.is_null()); pointer };
+        // The library is retained for the lifetime of this process.
+        Some(Provider { gemm: unsafe { std::mem::transmute(symbol("sgemm_")) }, threads: unsafe { std::mem::transmute(symbol("MKL_Set_Num_Threads_Local")) } })
+    });
+    let Some(provider) = provider else {return false;};
+    assert!([rows,input,output].iter().all(|n| *n<=i32::MAX as usize));
+    unsafe {
+        let previous = (provider.threads)(rayon::current_num_threads() as i32);
+        (provider.gemm)(c"T".as_ptr(),c"N".as_ptr(),&(output as i32),&(rows as i32),&(input as i32),&1.0,weight.as_ptr(),&(input as i32),x.as_ptr(),&(input as i32),&1.0,y.as_mut_ptr(),&(output as i32));
+        (provider.threads)(previous);
+    }
+    true
+}

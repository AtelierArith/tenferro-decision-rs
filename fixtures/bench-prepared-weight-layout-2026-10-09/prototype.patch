@@ -0,0 +1,98 @@
+use laya_infer::{
+    checkpoint::load_checkpoint,
+    model::{PREPARED_GEMM_DIAGNOSTIC, TensorCache, forward_tenferro_cached},
+};
+use serde_json::json;
+use std::{sync::atomic::Ordering, time::Instant};
+use tenferro_ad::EagerRuntime;
+use tenferro_cpu::CpuBackend;
+
+fn median(xs: &[f64]) -> f64 {
+    let mut xs = xs.to_vec();
+    xs.sort_by(f64::total_cmp);
+    xs[xs.len() / 2]
+}
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let checkpoint = load_checkpoint(args.get(1).expect("checkpoint directory")).unwrap();
+    let runtime = EagerRuntime::with_cpu_backend(CpuBackend::new()).unwrap();
+    let mut cache = TensorCache::new();
+    let mut results = Vec::new();
+    for (length, batch) in [(8usize, 1usize), (16, 1), (64, 1), (8, 8)] {
+        let base = [2, 100, 1000, 2000, 3000, 4000, 5, 3];
+        let ids: Vec<i64> = (0..length * batch)
+            .map(|i| base[(i % length) % 8])
+            .collect();
+        let mask = vec![true; length * batch];
+        let positions: Vec<i64> = (0..batch).flat_map(|_| [1, 3, 5]).collect();
+        let marker_mask = vec![true; 3 * batch];
+        let qtype = vec![0i64; batch];
+        let run = |cache: &mut TensorCache, prepared| {
+            PREPARED_GEMM_DIAGNOSTIC.store(prepared, Ordering::Relaxed);
+            let begin = Instant::now();
+            let output = runtime
+                .with_eager_session(|session| {
+                    forward_tenferro_cached(
+                        session,
+                        cache,
+                        &checkpoint.encoder,
+                        &checkpoint.agent,
+                        &checkpoint.weights,
+                        &ids,
+                        &mask,
+                        &positions,
+                        &marker_mask,
+                        &qtype,
+                    )
+                })
+                .unwrap()
+                .unwrap();
+            (begin.elapsed().as_secs_f64() * 1000.0, output)
+        };
+        let mut natural_warmup = Vec::new();
+        let mut prepared_warmup = Vec::new();
+        for _ in 0..2 {
+            natural_warmup.push(run(&mut cache, false).0);
+            prepared_warmup.push(run(&mut cache, true).0);
+        }
+        let mut natural = Vec::new();
+        let mut prepared = Vec::new();
+        let mut max_error = 0.0f32;
+        for pair in 0..15 {
+            let (old, new) = if pair % 2 == 0 {
+                let old = run(&mut cache, false);
+                (old, run(&mut cache, true))
+            } else {
+                let new = run(&mut cache, true);
+                (run(&mut cache, false), new)
+            };
+            natural.push(old.0);
+            prepared.push(new.0);
+            for (a, b) in old
+                .1
+                .0
+                .iter()
+                .chain(&old.1.1)
+                .zip(new.1.0.iter().chain(&new.1.1))
+            {
+                max_error = max_error.max((a - b).abs());
+                assert!(a.is_finite() && b.is_finite());
+                assert!((a - b).abs() <= 1e-6 * (1.0 + a.abs()));
+            }
+        }
+        results.push(
+            json!({"length":length,"batch":batch,"natural_ms":median(&natural),
+            "prepared_ms":median(&prepared),"max_abs_output_error":max_error,
+            "natural_samples_ms":natural,"prepared_samples_ms":prepared,"natural_warmup_ms":natural_warmup,"prepared_warmup_ms":prepared_warmup}),
+        );
+    }
+    let mut metadata = bench_suite::BenchMetadata::capture();
+    metadata.profile = Some("release".into());
+    let metadata: serde_json::Value = serde_json::from_str(&metadata.to_json()).unwrap();
+    println!(
+        "{}",
+        serde_json::to_string_pretty(&json!({"metadata":metadata,"warmup_per_layout":2,
+        "paired_iterations":15,"rayon_threads":rayon::current_num_threads(),"rows":results}))
+        .unwrap()
+    );
+}

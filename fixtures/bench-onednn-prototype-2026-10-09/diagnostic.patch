@@ -0,0 +1,15 @@
+//! Temporary supplied-library diagnostic; not a production API.
+use std::ffi::{CString,c_char,c_void};
+use std::sync::{OnceLock,atomic::{AtomicBool,Ordering}};
+#[link(name="dl")]
+unsafe extern "C" {fn dlopen(name:*const c_char,flags:i32)->*mut c_void;fn dlsym(handle:*mut c_void,name:*const c_char)->*mut c_void;}
+type Run=unsafe extern "C" fn(*const f32,i32,i32,*const f32,i32,*mut f32)->i32;
+static RUN:OnceLock<Option<Run>>=OnceLock::new();
+pub static ENABLED:AtomicBool=AtomicBool::new(false);
+pub fn run(x:&[f32],rows:usize,input:usize,w:&[f32],output:usize,y:&mut[f32])->bool {
+ if !ENABLED.load(Ordering::Relaxed){return false;}
+ let run=RUN.get_or_init(||{let path=CString::new(std::env::var("LAYA_DNNL_DIAGNOSTIC_LIBRARY").ok()?).unwrap();let h=unsafe{dlopen(path.as_ptr(),2)};assert!(!h.is_null());let p=unsafe{dlsym(h,c"diagnostic_run".as_ptr())};assert!(!p.is_null());Some(unsafe{std::mem::transmute::<*mut c_void,Run>(p)})});
+ let Some(run)=run else{return false;};
+ assert!([rows,input,output].iter().all(|n|*n<=i32::MAX as usize));
+ assert_eq!(unsafe{run(x.as_ptr(),rows as i32,input as i32,w.as_ptr(),output as i32,y.as_mut_ptr())},0);true
+}

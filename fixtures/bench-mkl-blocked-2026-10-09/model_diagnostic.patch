diff --git a/crates/cpu-kernels/src/mkl_diagnostic.rs b/crates/cpu-kernels/src/mkl_diagnostic.rs
new file mode 100644
index 0000000..0fb33e9
--- /dev/null
+++ b/crates/cpu-kernels/src/mkl_diagnostic.rs
@@ -0,0 +1,67 @@
+//! Diagnostic only: compare current GEMM with a separately supplied MKL library.
+use std::ffi::{CString, c_char, c_void};
+use std::time::Instant;
+#[link(name = "dl")]
+unsafe extern "C" {
+    fn dlopen(name: *const c_char, flags: i32) -> *mut c_void;
+    fn dlsym(handle: *mut c_void, name: *const c_char) -> *mut c_void;
+}
+type PackSize = unsafe extern "C" fn(i32,i32,i32,i32) -> usize;
+type Pack = unsafe extern "C" fn(i32,i32,i32,i32,i32,i32,f32,*const f32,i32,*mut f32);
+type Compute = unsafe extern "C" fn(i32,i32,i32,i32,i32,i32,*const f32,i32,*const f32,i32,f32,*mut f32,i32);
+type Threads = unsafe extern "C" fn(i32) -> i32;
+
+
+use rayon::prelude::*;
+struct Packed { address: usize, layout: std::alloc::Layout, offset: usize, width: usize }
+impl Drop for Packed { fn drop(&mut self) { unsafe { std::alloc::dealloc(self.address as *mut u8,self.layout); } } }
+
+use std::sync::{Arc, Mutex, OnceLock, atomic::{AtomicBool, Ordering}};
+use std::collections::HashMap;
+struct Provider { threads: Threads, size: PackSize, pack: Pack, compute: Compute }
+static PROVIDER: OnceLock<Option<Provider>>=OnceLock::new();
+static CACHE: OnceLock<Mutex<HashMap<(usize,usize,usize),Arc<Vec<Packed>>>>>=OnceLock::new();
+pub static ENABLED:AtomicBool=AtomicBool::new(false);
+pub fn run(x:&[f32],rows:usize,input:usize,w:&[f32],output:usize,y:&mut[f32])->bool {
+ if !ENABLED.load(Ordering::Relaxed) {return false;}
+ let p=PROVIDER.get_or_init(||{
+ let path=CString::new(std::env::var("LAYA_MKL_DIAGNOSTIC_LIBRARY").ok()?).unwrap();
+ let handle=unsafe{dlopen(path.as_ptr(),2)};assert!(!handle.is_null());
+ let lookup=|name:&str|{let n=CString::new(name).unwrap();let p=unsafe{dlsym(handle,n.as_ptr())};assert!(!p.is_null());p};
+ Some(Provider{threads:unsafe{std::mem::transmute(lookup("MKL_Set_Num_Threads_Local"))},size:unsafe{std::mem::transmute(lookup("cblas_sgemm_pack_get_size"))},pack:unsafe{std::mem::transmute(lookup("cblas_sgemm_pack"))},compute:unsafe{std::mem::transmute(lookup("cblas_sgemm_compute"))}})
+ });
+ let Some(p)=p else{return false;};
+ if rows==0 || input==0 || output==0 {return false;}
+ let key=(w.as_ptr()as usize,input,output);
+ let packed={
+ let mut cache=CACHE.get_or_init(||Mutex::new(HashMap::new())).lock().unwrap();
+ Arc::clone(cache.entry(key).or_insert_with(||{
+ let block=if output>1024 {192}else{128};
+ let prior=unsafe{(p.threads)(1)};
+ let plan:Vec<_>=(0..output).step_by(block).map(|offset|{
+ let width=block.min(output-offset);
+ let layout=std::alloc::Layout::from_size_align(unsafe{(p.size)(162,32,width as i32,input as i32)},64).unwrap();
+ let address=unsafe{std::alloc::alloc_zeroed(layout)}as usize;assert_ne!(address,0);
+ unsafe{(p.pack)(101,162,112,32,width as i32,input as i32,1.,w.as_ptr().add(offset*input),input as i32,address as *mut f32)};
+ Packed{address,layout,offset,width}
+ }).collect();
+ unsafe{(p.threads)(prior)};
+ Arc::new(plan)
+ }))};
+ let mut padded=Vec::new();
+ let input_data=if rows%32==0 {x}else{padded.extend_from_slice(x);padded.resize(rows.div_ceil(32)*32*input,0.);&padded};
+ let address=y.as_mut_ptr()as usize;
+ packed.par_iter().for_each(|b|{
+ let prior=unsafe{(p.threads)(1)};
+ for row in (0..rows).step_by(32){
+ if rows-row>=32 {unsafe{(p.compute)(101,111,151,32,b.width as i32,input as i32,input_data.as_ptr().add(row*input),input as i32,b.address as *const f32,0,1.,(address as *mut f32).add(row*output+b.offset),output as i32)}}
+ else {
+ let mut tail=vec![0.;32*b.width];
+ for t in 0..rows-row {unsafe{std::ptr::copy_nonoverlapping((address as *const f32).add((row+t)*output+b.offset),tail.as_mut_ptr().add(t*b.width),b.width)}}
+ unsafe{(p.compute)(101,111,151,32,b.width as i32,input as i32,input_data.as_ptr().add(row*input),input as i32,b.address as *const f32,0,1.,tail.as_mut_ptr(),b.width as i32)};
+ for t in 0..rows-row {unsafe{std::ptr::copy_nonoverlapping(tail.as_ptr().add(t*b.width),(address as *mut f32).add((row+t)*output+b.offset),b.width)}}
+ }
+ }
+ unsafe{(p.threads)(prior)};
+ });true
+}
